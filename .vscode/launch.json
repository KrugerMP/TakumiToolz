{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Takumi Web",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Takumi.Web/bin/Debug/net9.0/Takumi.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Takumi.Web",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Takumi API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api",
      "program": "${workspaceFolder}/src/Taukimi.Api/bin/Debug/net9.0/Taukimi.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Taukimi.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },

  ],
  "compounds": [
    {
      "name": "Launch Both (Web + API)",
      "configurations": ["Launch Takumi Web", "Launch Takumi API"],
      "stopAll": true
    }
  ]
}
